{
  "name": "Recepção 24h",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -r requirements.txt",
  "postAttachCommand": "python seed.py && uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Recepção 24h", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "GEMINI_API_KEY": { "description": "Chave gratuita do Gemini (aistudio.google.com/apikey)" }
  }
}
